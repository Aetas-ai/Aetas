---
interface Props {
  label: string;
  class?: string;
}
const { label, class: className = '' } = Astro.props;
---

<button type="submit" class:list={['form-submit-button', className]}>
  <span data-submit-label>{label}</span>
  <span data-submit-pending hidden>
    <svg class="form-submit-spinner" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity="0.25" />
      <path d="M12 3a9 9 0 0 1 9 9" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
    </svg>
    <span>Sending…</span>
  </span>
</button>
