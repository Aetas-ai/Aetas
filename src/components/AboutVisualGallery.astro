---
import PartnerLogo from './PartnerLogo.astro';
import { cloudAiPartners, securityPartners, type PartnerLogo as Logo } from '../data/partner-logos';

/*
 * Code-built tiles that replace the former generated imagery. Every tile shows
 * approved AGI content only (service lines, approved workflow steps, approved
 * partner logos); no photos, no metrics, no invented detail.
 */
type Tile =
  | { kind: 'flow'; service: string; label: string; accent: string; steps: string[] }
  | { kind: 'chips'; service: string; label: string; accent: string; items: string[] }
  | { kind: 'decision'; service: string; label: string; accent: string }
  | { kind: 'tiers'; service: string; label: string; accent: string }
  | { kind: 'logos'; service: string; label: string; accent: string; logos: Logo[] };

const tiles = {
  oversight: { kind: 'decision', service: 'AI & Automation', label: 'Expert in the Loop', accent: 'governance' },
  workflow: { kind: 'flow', service: 'AI & Automation', label: 'Human Led AI workflow', accent: 'ai', steps: ['Ingest the work', 'Assist the operator', 'Apply expert oversight', 'Improve the process'] },
  assimilation: { kind: 'chips', service: 'AI & Automation', label: 'Business Process AI Assimilation', accent: 'ai', items: ['Quality checks', 'Agent assistance', 'Knowledge retrieval', 'Ticket summarization'] },
  mxdr: { kind: 'flow', service: 'Cybersecurity', label: 'MXDR', accent: 'security', steps: ['Monitor', 'Investigate', 'Respond', 'Document'] },
  offensive: { kind: 'chips', service: 'Cybersecurity', label: 'Offensive Security', accent: 'security', items: ['Network Security Testing', 'Application Security Testing (Pen Testing)'] },
  cloud: { kind: 'logos', service: 'Technology', label: 'Cloud & AI partners', accent: 'ai', logos: cloudAiPartners },
  security: { kind: 'logos', service: 'Technology', label: 'Cybersecurity partners', accent: 'security', logos: [securityPartners[0], securityPartners[6], securityPartners[1], securityPartners[5]] },
  helpdesk: { kind: 'tiers', service: 'Managed IT', label: 'Help Desk as a Service', accent: 'global' },
  managed: { kind: 'chips', service: 'Managed IT', label: 'Managed IT operations', accent: 'global', items: ['Identity & Access', 'Device Management', 'Tenant Administration', 'Product Support as a Service'] },
  ownership: { kind: 'flow', service: 'Every engagement', label: 'Defined ownership', accent: 'mixed', steps: ['Identify', 'Scope', 'Assign', 'Review'] },
} satisfies Record<string, Tile>;

const lanes: Tile[][] = [
  [tiles.oversight, tiles.mxdr, tiles.helpdesk, tiles.cloud, tiles.ownership],
  [tiles.security, tiles.assimilation, tiles.managed, tiles.workflow, tiles.offensive],
  [tiles.managed, tiles.workflow, tiles.offensive, tiles.oversight, tiles.security],
];

const services = [
  { name: 'AI & Automation', href: '/ai', detail: 'Human Led AI', accent: 'ai' },
  { name: 'Cybersecurity', href: '/security', detail: 'MSSP / MXDR / Offensive Security', accent: 'security' },
  { name: 'Managed IT', href: '/managed-it', detail: 'MSP / Help Desk / Product Support', accent: 'global' },
] as const;
---

<section id="about-visual-gallery" class="about-gallery-section agi-section scroll-mt-20 border-y border-white/5 bg-black/30" aria-labelledby="about-gallery-title">
  <div class="mx-auto grid max-w-7xl min-w-0 gap-12 lg:grid-cols-12 lg:items-center">
    <div class="min-w-0 lg:col-span-4" data-reveal>
      <span class="agi-eyebrow accent-security">Across AGI</span>
      <h2 id="about-gallery-title" class="mt-4 max-w-xl font-display text-h2 font-bold text-white">
        Specialized expertise across three service areas.
      </h2>
      <p class="mt-5 max-w-lg text-[0.9375rem] leading-relaxed text-muted">
        AGI coordinates AI and automation, cybersecurity, and managed IT expertise around client needs. Each service area remains easy to understand, scope, and engage.
      </p>

      <nav class="mt-8 grid gap-px overflow-hidden border border-white/10 bg-white/10" aria-label="Explore AGI services">
        {services.map((service) => (
          <a href={service.href} class:list={['gallery-practice', `gallery-practice-${service.accent}`]}>
            <span>
              <strong>{service.name}</strong>
              <small>{service.detail}</small>
            </span>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h11M11 6l4 4-4 4"></path>
            </svg>
          </a>
        ))}
      </nav>
    </div>

    <div class="gallery-stage min-w-0 lg:col-span-8" data-reveal-right data-motion>
      <div class="gallery-frame" aria-hidden="true">
        <div class="gallery-grid"></div>
        <div class="gallery-plane">
          {lanes.map((lane, laneIndex) => (
            <div class:list={['gallery-lane', `gallery-lane-${laneIndex + 1}`]}>
              <div class="gallery-track">
                {[0, 1].map((groupIndex) => (
                  <div class="gallery-group" aria-hidden={groupIndex === 1 ? 'true' : undefined}>
                    {lane.map((tile) => (
                      <figure class:list={['gallery-tile', `gallery-tile-${tile.accent}`, `gallery-tile--${tile.kind}`]}>
                        <span class="tile-service">{tile.service}</span>
                        <div class="tile-body">
                          {tile.kind === 'flow' && (
                            <ol class="tile-flow">
                              {tile.steps.map((step, index) => (
                                <li><span>{index + 1}</span>{step}</li>
                              ))}
                            </ol>
                          )}
                          {tile.kind === 'chips' && (
                            <ul class="tile-chips">
                              {tile.items.map((item) => <li>{item}</li>)}
                            </ul>
                          )}
                          {tile.kind === 'decision' && (
                            <div class="tile-decision">
                              <p class="tile-draft"><span>AI draft</span>Ready for expert review</p>
                              <p class="tile-actions"><span>Approve</span><span>Edit</span><span>Escalate</span></p>
                            </div>
                          )}
                          {tile.kind === 'tiers' && (
                            <div class="tile-tiers">
                              <p><span>L1</span><span>L2</span><span>L3</span></p>
                              <small>Documented resolution or escalation</small>
                            </div>
                          )}
                          {tile.kind === 'logos' && (
                            <div class="tile-logos">
                              {tile.logos.map((logo) => <PartnerLogo logo={logo} height="7.5cqi" />)}
                            </div>
                          )}
                        </div>
                        <figcaption>{tile.label}</figcaption>
                      </figure>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="gallery-axis gallery-axis-top">
          <span>AGI / Operating perspectives</span>
          <span>01—03</span>
        </div>
        <div class="gallery-axis gallery-axis-bottom">
          <i></i><i></i><i></i>
          <span>Specialized services / One AGI</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-gallery-section { min-width: 0; overflow: hidden; }

  .gallery-practice {
    --practice-color: white;
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--color-brand-bg);
    padding: 0.9rem 1rem;
    color: white;
    text-decoration: none;
    transition: background-color 180ms ease;
  }
  .gallery-practice:hover,
  .gallery-practice:focus-visible { background: rgba(255, 255, 255, 0.045); }
  .gallery-practice:focus-visible {
    position: relative;
    z-index: 1;
    outline: 2px solid var(--practice-color);
    outline-offset: -2px;
  }
  .gallery-practice-ai { --practice-color: var(--color-ai); }
  .gallery-practice-security { --practice-color: var(--color-security); }
  .gallery-practice-global { --practice-color: var(--color-global); }
  .gallery-practice strong,
  .gallery-practice small { display: block; }
  .gallery-practice strong { font-family: var(--font-display); font-size: 0.9375rem; }
  .gallery-practice small {
    margin-top: 0.25rem;
    color: rgb(156 163 175);
    font-size: 0.75rem;
    line-height: 1.35;
  }
  .gallery-practice svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
    color: var(--practice-color);
    transition: transform 180ms ease;
  }
  .gallery-practice svg path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }
  .gallery-practice:hover svg,
  .gallery-practice:focus-visible svg { transform: translateX(3px); }

  .gallery-stage {
    position: relative;
    height: clamp(30rem, 49vw, 39rem);
    perspective: 1100px;
  }
  .gallery-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-block: 1px solid rgba(255, 255, 255, 0.09);
    background: #06070a;
    isolation: isolate;
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);
    mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);
  }
  .gallery-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 72px 72px;
  }
  .gallery-plane {
    position: absolute;
    top: -32%;
    left: -8%;
    display: grid;
    width: 116%;
    height: 165%;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.55rem, 1.3vw, 0.9rem);
    transform: rotateX(8deg) rotateY(-6deg) rotateZ(-5deg) scale(1.04);
    transform-style: preserve-3d;
  }
  .gallery-lane { min-width: 0; overflow: hidden; }
  .gallery-track { transform: translate3d(0, 0, 0); }
  .gallery-lane-1 .gallery-track { animation: gallery-up 34s linear infinite; }
  .gallery-lane-2 .gallery-track { animation: gallery-down 39s linear infinite; }
  .gallery-lane-3 .gallery-track { animation: gallery-up 43s linear infinite -13s; }
  .gallery-group {
    display: flex;
    flex-direction: column;
    gap: clamp(0.55rem, 1.3vw, 0.9rem);
    padding-bottom: clamp(0.55rem, 1.3vw, 0.9rem);
  }
  .gallery-tile {
    --tile-color: rgba(255, 255, 255, 0.28);
    position: relative;
    min-width: 0;
    aspect-ratio: 16 / 10;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 2px solid var(--tile-color);
    border-radius: 0.375rem;
    background:
      radial-gradient(120% 70% at 50% 0%, color-mix(in srgb, var(--tile-color) 11%, transparent), transparent 70%),
      var(--surface-2);
    box-shadow: 0 15px 38px rgba(0, 0, 0, 0.32);
    /* Tile text scales with the tile, not the viewport. */
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    /* Own padding cannot use cqi (it would resolve against the viewport). */
    padding: clamp(0.6rem, 1.2vw, 1rem) clamp(0.65rem, 1.3vw, 1.1rem);
    color: #e5e7eb;
  }
  .gallery-tile-ai { --tile-color: var(--color-ai); }
  .gallery-tile-security { --tile-color: var(--color-security); }
  .gallery-tile-global { --tile-color: var(--color-global); }
  .gallery-tile-governance { --tile-color: var(--color-governance); }
  .gallery-tile-mixed { --tile-color: #a5b4fc; }

  .tile-service {
    color: color-mix(in srgb, var(--tile-color) 70%, white);
    font-size: 3.6cqi;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tile-body {
    display: flex;
    min-height: 0;
    flex: 1;
    align-items: center;
  }
  .gallery-tile figcaption {
    overflow: hidden;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 5.4cqi;
    font-weight: 700;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Numbered steps, e.g. the approved MXDR and engagement stages. */
  .tile-flow {
    display: grid;
    width: 100%;
    gap: 2.2cqi;
  }
  .tile-flow li {
    display: flex;
    align-items: center;
    gap: 3cqi;
    font-size: 4.4cqi;
    line-height: 1.15;
    color: #d1d5db;
  }
  .tile-flow li span {
    display: inline-grid;
    width: 6.2cqi;
    height: 6.2cqi;
    flex: none;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--tile-color) 45%, transparent);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--tile-color) 14%, transparent);
    color: color-mix(in srgb, var(--tile-color) 60%, white);
    font-family: var(--font-mono);
    font-size: 3.2cqi;
  }

  .tile-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 2cqi;
  }
  .tile-chips li {
    border: 1px solid color-mix(in srgb, var(--tile-color) 32%, transparent);
    border-radius: 1.6cqi;
    background: color-mix(in srgb, var(--tile-color) 9%, transparent);
    padding: 1.3cqi 2.6cqi;
    color: #e5e7eb;
    font-size: 4cqi;
    line-height: 1.2;
  }

  .tile-decision {
    display: grid;
    width: 100%;
    gap: 3cqi;
  }
  .tile-draft {
    display: grid;
    gap: 0.8cqi;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 2cqi;
    background: rgba(0, 0, 0, 0.25);
    padding: 2.6cqi 3.2cqi;
    font-size: 4.2cqi;
    color: #d1d5db;
  }
  .tile-draft span {
    color: #a5b4fc;
    font-size: 3.2cqi;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tile-actions {
    display: flex;
    gap: 2cqi;
  }
  .tile-actions span {
    flex: 1;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1.6cqi;
    padding: 1.6cqi 0;
    color: #e5e7eb;
    font-size: 3.8cqi;
    font-weight: 600;
    text-align: center;
  }
  .tile-actions span:first-child {
    border-color: color-mix(in srgb, var(--tile-color) 55%, transparent);
    background: color-mix(in srgb, var(--tile-color) 18%, transparent);
  }

  .tile-tiers {
    display: grid;
    width: 100%;
    gap: 3cqi;
  }
  .tile-tiers p {
    display: flex;
    align-items: center;
    gap: 2cqi;
  }
  .tile-tiers p span {
    flex: 1;
    border: 1px solid color-mix(in srgb, var(--tile-color) 35%, transparent);
    border-radius: 1.6cqi;
    background: color-mix(in srgb, var(--tile-color) 10%, transparent);
    padding: 2.4cqi 0;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 5cqi;
    font-weight: 700;
    text-align: center;
  }
  .tile-tiers small {
    color: #9aa3b2;
    font-size: 3.8cqi;
  }

  .tile-logos {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    justify-items: center;
    gap: 4cqi 5cqi;
  }
  .tile-logos :global(svg),
  .tile-logos :global(img) {
    max-width: 100%;
    object-fit: contain;
  }

  .gallery-stage:hover .gallery-track { animation-play-state: paused; }

  .gallery-axis {
    position: absolute;
    right: 1rem;
    left: 1rem;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(156, 163, 175, 0.72);
    font-family: var(--font-display);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .gallery-axis-top { top: 1.1rem; }
  .gallery-axis-bottom { bottom: 1.1rem; justify-content: flex-start; gap: 0.35rem; }
  .gallery-axis-bottom i { width: 1.7rem; height: 2px; }
  .gallery-axis-bottom i:nth-child(1) { background: var(--color-ai); }
  .gallery-axis-bottom i:nth-child(2) { background: var(--color-security); }
  .gallery-axis-bottom i:nth-child(3) { margin-right: 0.4rem; background: var(--color-global); }

  @keyframes gallery-up {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(0, -50%, 0); }
  }
  @keyframes gallery-down {
    from { transform: translate3d(0, -50%, 0); }
    to { transform: translate3d(0, 0, 0); }
  }

  @media (max-width: 767px) {
    .gallery-stage { height: clamp(23rem, 102vw, 31rem); }
    .gallery-plane {
      top: -30%;
      left: -10%;
      width: 120%;
      height: 165%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
      transform: rotateX(6deg) rotateY(-4deg) rotateZ(-4deg) scale(1.03);
    }
    .gallery-lane-3 { display: none; }
    .gallery-group { gap: 0.55rem; padding-bottom: 0.55rem; }
    .gallery-axis { right: 0.75rem; left: 0.75rem; }
  }

  @media (max-width: 479px) {
    .gallery-axis-top span:last-child { display: none; }
    .gallery-axis-bottom span { font-size: 0.5rem; }
    .gallery-axis-bottom i { width: 1.05rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-track { animation: none !important; }
    .gallery-group[aria-hidden='true'] { display: none; }
    .gallery-plane { top: -8%; height: 116%; }
  }
</style>
