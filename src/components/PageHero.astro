---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  accent?: 'ai' | 'security' | 'global' | 'neutral';
  image?: ImageMetadata;
  imageAlt?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  focusLabel?: string;
  focusItems?: string[];
  compact?: boolean;
}

const {
  eyebrow,
  title,
  description,
  accent = 'neutral',
  image,
  imageAlt = '',
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  focusLabel = 'Service focus',
  focusItems = [],
  compact = false,
} = Astro.props;

const accentClass = accent === 'neutral' ? undefined : `accent-${accent}`;
const heroId = `page-hero-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
---

<section
  class:list={[
    'page-hero relative isolate flex items-center overflow-hidden border-b border-white/5 bg-brand-bg px-6',
    compact ? 'min-h-[360px] py-14 sm:min-h-[400px] sm:py-16' : 'page-hero-full py-14 sm:py-16 lg:py-20',
  ]}
  aria-labelledby={heroId}
>
  {image ? (
    <div class="absolute inset-0 -z-20">
      <Image src={image} alt={imageAlt} widths={[640, 960, 1440]} sizes="100vw" class="h-full w-full object-cover object-center brightness-[0.3] saturate-[0.72] scale-[1.01]" loading="eager" decoding="async" fetchpriority="high" />
    </div>
  ) : null}

  <div class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(rgba(255,255,255,0.032)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.032)_1px,transparent_1px)] bg-[size:64px_64px] [mask-image:linear-gradient(to_bottom,black,transparent_94%)]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(100deg,#050508_0%,rgba(5,5,8,0.97)_43%,rgba(5,5,8,0.72)_70%,rgba(5,5,8,0.48)_100%)] max-xl:bg-[linear-gradient(180deg,rgba(5,5,8,0.82)_0%,#050508_96%)]" aria-hidden="true"></div>

  <div class:list={['page-hero-shell mx-auto grid min-w-0 w-full max-w-7xl items-center gap-12', focusItems.length > 0 ? 'xl:grid-cols-[minmax(0,1.15fr)_minmax(320px,0.85fr)] xl:gap-16' : '']}>
    <div class:list={['agi-hero-enter flex min-w-0 max-w-3xl flex-col items-start gap-5 sm:gap-6', accentClass]}>
      <span class="agi-eyebrow">{eyebrow}</span>

      <h1 id={heroId} class="page-hero-title max-w-full font-display text-display font-bold text-white [overflow-wrap:anywhere]">
        {title}
      </h1>

      <p class="max-w-2xl text-lede text-gray-300">
        {description}
      </p>

      {(primaryLabel && primaryHref) || (secondaryLabel && secondaryHref) ? (
        <div class="flex w-full flex-col gap-3 pt-2 sm:w-auto sm:flex-row sm:items-center">
          {primaryLabel && primaryHref ? (
            <Button href={primaryHref} accent={accent} arrow stretch>{primaryLabel}</Button>
          ) : null}
          {secondaryLabel && secondaryHref ? (
            <Button href={secondaryHref} variant="secondary" stretch>{secondaryLabel}</Button>
          ) : null}
        </div>
      ) : null}

      <slot />
    </div>

    {focusItems.length > 0 ? (
      <div class:list={['agi-hero-focus hidden xl:block', accentClass]} aria-label={`${eyebrow} focus areas`}>
        <div class="border-l border-[color-mix(in_srgb,var(--accent,#fff)_28%,transparent)] pl-8">
          <span class="agi-eyebrow">{focusLabel}</span>
          <ol class="mt-6 space-y-0">
            {focusItems.map((item, index) => (
              <li class="flex min-h-16 items-center gap-5 border-t border-white/10 py-4 last:border-b">
                <span class="font-display text-xs font-bold text-[var(--accent-text,#d1d5db)]">0{index + 1}</span>
                <span class="text-sm font-semibold text-white">{item}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    ) : null}
  </div>

  <div class:list={['pointer-events-none absolute inset-x-0 bottom-0 h-px bg-[var(--accent,rgba(255,255,255,0.6))]', accentClass]} aria-hidden="true"></div>
</section>

<style>
  .agi-hero-focus {
    animation: agi-hero-focus-in 720ms var(--ease-out-expo) 120ms both;
  }

  @keyframes agi-hero-focus-in {
    from { transform: translate3d(18px, 0, 0); }
  }

  .page-hero-full {
    min-height: calc(100vh - var(--site-header-height));
    min-height: calc(100dvh - var(--site-header-height));
  }

  @media (min-width: 1024px) and (max-height: 800px) {
    .page-hero {
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
    }

    .page-hero-title {
      font-size: min(var(--text-display), 3.25rem);
    }
  }
</style>
