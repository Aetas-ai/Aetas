---
import Button from './Button.astro';
import AgiNetworkGraph from './AgiNetworkGraph.astro';

const services = [
  { number: '01', service: 'AI & Automation', outcome: 'Better workflows', scope: 'Human Led AI and Business Process AI Assimilation', href: '/ai', accent: 'ai' },
  { number: '02', service: 'Cybersecurity', outcome: 'Stronger resilience', scope: 'MSSP, MXDR, and Offensive Security', href: '/security', accent: 'security' },
  { number: '03', service: 'Managed IT', outcome: 'Dependable operations', scope: 'MSP, help desk, product support, and Business Processes', href: '/managed-it', accent: 'global' },
] as const;
---

<section class="home-hero relative isolate w-full max-w-full overflow-x-clip" aria-labelledby="home-hero-title">
  <div class="home-hero-stage relative isolate">
    <div class="home-hero-light pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="agi-grid-mask" aria-hidden="true"></div>

    <div class="relative mx-auto grid w-full min-w-0 max-w-7xl items-center gap-12 px-6 pb-14 pt-12 sm:pt-16 lg:grid-cols-2 lg:gap-14 lg:pb-20 lg:pt-20">
      <div class="flex w-full min-w-0 max-w-xl flex-col items-start gap-6">
        <span class="home-hero-enter home-hero-pill">
          <span class="home-hero-pill-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          Aetas Global Innovation
        </span>

        <h1 id="home-hero-title" class="home-hero-enter home-hero-enter-2 w-full font-display text-[2.6rem] font-bold leading-[1.02] tracking-[-0.035em] text-white [overflow-wrap:anywhere] sm:text-6xl lg:text-[4.25rem]">
          Make complex operations <span class="home-hero-accent">easier to run.</span>
        </h1>

        <p class="home-hero-enter home-hero-enter-3 w-full max-w-lg text-base leading-relaxed text-gray-300 [overflow-wrap:anywhere] sm:text-lg">
          Aetas Global Innovation helps organizations apply Human Led AI, strengthen cyber defense, and run dependable IT and business operations through specialized teams coordinated around their needs.
        </p>

        <div class="home-hero-enter home-hero-enter-4 flex w-full min-w-0 max-w-full flex-col gap-3 pt-1 sm:w-auto sm:flex-row sm:items-center">
          <Button href="/contact" arrow stretch class="px-6">Discuss your operations</Button>
          <Button href="#services" variant="secondary" stretch class="px-6">Explore AGI services</Button>
        </div>

        <p class="home-hero-enter home-hero-enter-5 flex w-full max-w-lg items-start gap-3 text-[0.8125rem] leading-relaxed text-gray-400 [overflow-wrap:anywhere]">
          <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-governance" aria-hidden="true"></span>
          AGI AI and automation engagements include Expert Human Oversight of AI through defined review and escalation paths.
        </p>
      </div>

      <div class="home-hero-network home-hero-visual-enter relative min-w-0" data-motion>
        <AgiNetworkGraph />
      </div>
    </div>
  </div>

  <nav class="home-hero-practices" aria-label="AGI service areas">
    <div class="mx-auto grid max-w-7xl md:grid-cols-3">
      {services.map((item) => (
        <a
          href={item.href}
          class:list={[
            'hero-practice hero-practice-enter group relative flex items-center gap-4 border-b border-white/[0.06] px-6 py-5 focus-visible:z-10 md:border-b-0 md:border-r md:last:border-r-0',
            `hero-practice-${item.accent}`,
          ]}
        >
          <span class="hero-practice-number self-start pt-0.5 font-display text-xs font-bold">{item.number}</span>
          <span class="min-w-0 flex-1">
            <span class="block text-[11px] font-semibold uppercase tracking-[0.12em] text-gray-400">{item.service}</span>
            <span class="mt-1 block font-display text-base font-semibold text-white sm:text-lg">{item.outcome}</span>
            <span class="mt-0.5 block text-xs leading-relaxed text-gray-500 transition-colors duration-200 group-hover:text-gray-300">{item.scope}</span>
          </span>
          <span class="hero-practice-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </nav>
</section>

<style>
  .home-hero {
    display: flex;
    min-width: 0;
    flex-direction: column;
    background: var(--color-brand-bg);
  }

  .home-hero-stage {
    display: flex;
    flex: 1 0 auto;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .home-hero {
      min-height: calc(100vh - var(--site-header-height));
      min-height: calc(100dvh - var(--site-header-height));
    }
  }

  .home-hero-network { min-height: 20rem; }

  @media (min-width: 1024px) {
    .home-hero-network { min-height: 34rem; }
  }

  @media (min-width: 1280px) and (max-height: 800px) {
    .home-hero-network { min-height: 30rem; }
  }

  .home-hero-light {
    background:
      radial-gradient(40rem 26rem at 78% 18%, color-mix(in srgb, var(--color-ai) 14%, transparent), transparent 70%),
      radial-gradient(30rem 22rem at 92% 70%, color-mix(in srgb, var(--color-security) 8%, transparent), transparent 70%),
      radial-gradient(36rem 20rem at 12% 0%, color-mix(in srgb, var(--color-global) 5%, transparent), transparent 70%);
  }

  .home-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    border: 1px solid var(--line-strong);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.3rem 0.75rem 0.3rem 0.5rem;
    color: #d1d5db;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .home-hero-pill-dots {
    display: inline-flex;
    gap: 0.2rem;
  }

  .home-hero-pill-dots span {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
  }

  .home-hero-pill-dots span:nth-child(1) { background: var(--color-ai); }
  .home-hero-pill-dots span:nth-child(2) { background: var(--color-security); }
  .home-hero-pill-dots span:nth-child(3) { background: var(--color-global); }

  .home-hero-accent {
    background: linear-gradient(95deg, #c7d2fe 0%, #7dd3fc 55%, #fde68a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Hero text animates transform only, so it paints at once and LCP is not
     delayed; the product window and service rail may fade in. */
  .home-hero-visual-enter,
  .hero-practice-enter {
    opacity: 0;
  }

  .home-hero-enter {
    animation: agi-rise 680ms var(--ease-out-expo) both;
  }

  .home-hero-enter-2 { animation-delay: 50ms; }
  .home-hero-enter-3 { animation-delay: 100ms; }
  .home-hero-enter-4 { animation-delay: 150ms; }
  .home-hero-enter-5 { animation-delay: 200ms; }

  .home-hero-visual-enter {
    transform: translate3d(0, 1.25rem, 0) scale(0.985);
    animation: home-hero-visual-in 860ms var(--ease-out-expo) 160ms forwards;
  }

  .hero-practice-enter {
    transform: translate3d(0, 0.6rem, 0);
    animation: home-hero-content-in 560ms var(--ease-out-expo) forwards;
  }

  .hero-practice-enter:nth-child(1) { animation-delay: 420ms; }
  .hero-practice-enter:nth-child(2) { animation-delay: 480ms; }
  .hero-practice-enter:nth-child(3) { animation-delay: 540ms; }

  @keyframes home-hero-content-in {
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  @keyframes home-hero-visual-in {
    to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  }

  .home-hero-practices {
    border-top: 1px solid var(--line-subtle);
    background: var(--surface-1);
  }

  .hero-practice {
    isolation: isolate;
    transition: background-color 200ms ease;
  }

  .hero-practice::before {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    opacity: 0.8;
    transition: opacity 200ms ease;
    content: '';
  }

  .hero-practice-ai { --accent: var(--color-ai); }
  .hero-practice-security { --accent: var(--color-security); }
  .hero-practice-global { --accent: var(--color-global); }
  .hero-practice::before { background: linear-gradient(90deg, var(--accent), transparent 80%); }

  .hero-practice-number {
    color: color-mix(in srgb, var(--accent) 60%, white);
  }

  .hero-practice-arrow {
    color: #6b7280;
    transition: transform 200ms var(--ease-out-expo), color 200ms ease;
  }

  .hero-practice:hover,
  .hero-practice:focus-visible {
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 7%, transparent), transparent 85%);
  }

  .hero-practice:hover .hero-practice-arrow,
  .hero-practice:focus-visible .hero-practice-arrow {
    color: #ffffff;
    transform: translateX(3px);
  }

  .hero-practice:focus-visible {
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-enter,
    .home-hero-visual-enter,
    .hero-practice-enter {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
