---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import AboutVisualGallery from '../components/AboutVisualGallery.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { visuals } from '../lib/visuals';

const services = [
  { title: 'AI & Automation', accent: 'ai', image: visuals.aiWorkflows, body: 'Human Led AI and Business Process AI Assimilation for recurring workflows, with Expert Human Oversight of AI (Expert in the Loop).' },
  { title: 'Cybersecurity', accent: 'security', image: visuals.securityOps, body: 'MSSP services including Managed Extended Detection and Response (MXDR), Network Security Testing, and Application Security Testing (Pen Testing).' },
  { title: 'Managed IT', accent: 'global', image: visuals.globalOps, body: 'MSP services including Help Desk as a Service, Product Support as a Service, managed IT, and Business Processes operations.' },
];

const principles = [
  ['Clear service choices', 'AI and automation, cybersecurity, and managed IT are presented as specialized AGI services with clear scopes.'],
  ['Human accountability', 'Human Led AI includes Expert Human Oversight of AI for decisions that affect customers, accounts, systems, or security.'],
  ['Defined ownership', 'Each engagement identifies responsibilities, review points, handoffs, and escalation paths.'],
  ['Scope before delivery', 'Work begins by clarifying the client need, service boundaries, dependencies, and expected outcomes.'],
];
---

<Layout
  title="About Aetas Global Innovation | AI, Cybersecurity & Managed IT"
  description="Learn how Aetas Global Innovation coordinates specialized AI and automation, cybersecurity, and managed IT services around client requirements."
>
  <PageHero
    eyebrow="About Aetas Global Innovation"
    title="Specialized expertise for intelligent, secure operations."
    description="AGI provides Human Led AI and automation, cybersecurity, and managed IT through dedicated service teams coordinated around client requirements."
    accent="neutral"
    image={visuals.aboutAgi}
    imageAlt="Aetas Global Innovation service network visualization"
    primaryLabel="Explore AGI services"
    primaryHref="/#services"
    secondaryLabel="Talk to AGI"
    secondaryHref="/contact"
  />

  <section class="section-light-muted agi-section">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-12 lg:items-center">
      <SectionHeading
        class="lg:col-span-5"
        accent="global"
        eyebrow="Why the name AGI"
        title="An intentional name with a practical operating focus."
      />
      <div class="space-y-5 text-[0.9375rem] leading-relaxed text-muted lg:col-span-7 lg:text-base" data-reveal>
        <p>
          Aetas Global Innovation is the company name, and AGI is its acronym. The connection to artificial general intelligence is intentional. For AGI, the name represents a practical focus: applying intelligence responsibly to real business work while keeping people accountable for high-impact decisions.
        </p>
        <p>
          AGI applies Human Led AI with Expert Human Oversight of AI, delivers dedicated cybersecurity services, and operates managed IT, help desk, product support, and Business Processes services. Each engagement brings in the specialized expertise the requirement needs.
        </p>
      </div>
    </div>
  </section>

  <AboutVisualGallery />

  <section class="section-light agi-section">
    <div class="mx-auto max-w-7xl">
      <SectionHeading accent="ai" eyebrow="AGI Services" title="Specialized expertise for different operational needs." class="mb-14" />

      <div class="grid gap-6 md:grid-cols-3" data-reveal-group>
        {services.map((service) => (
          <article class:list={['agi-card agi-card--light agi-card--accent agi-card--interactive overflow-hidden p-0', `accent-${service.accent}`]}>
            <Image src={service.image} alt={`${service.title} service visualization`} widths={[480, 768]} sizes="(min-width: 768px) 30vw, 100vw" class="aspect-video w-full object-cover" loading="lazy" decoding="async" />
            <div class="p-7">
              <h3 class="font-display text-xl font-bold text-strong">{service.title}</h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{service.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-dark-raised agi-section">
    <div class="mx-auto grid max-w-7xl gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {principles.map(([title, body]) => (
        <article class="agi-card agi-card--dark">
          <h3 class="font-display text-lg font-bold text-white">{title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-light agi-section">
    <SectionHeading
      align="center"
      title="Start with the AGI service that matches your need."
      lede="Tell us whether your requirement involves Business Process AI Assimilation, cybersecurity, or managed IT and Business Processes operations. AGI will connect you with the specialists best suited to scope it."
    >
      <Button href="/contact" tone="light" arrow class="mt-2">Talk to AGI</Button>
    </SectionHeading>
  </section>
</Layout>
