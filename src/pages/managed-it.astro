---
import Layout from '../layouts/Layout.astro';
import ServiceFaqSection from '../components/ServiceFaqSection.astro';
import BriefPromo from '../components/BriefPromo.astro';
import PageHero from '../components/PageHero.astro';
import ManagedSystems from '../components/ManagedSystems';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceDeskQueue from '../components/demos/ServiceDeskQueue';

const groups = [
  {
    id: 'help-desk',
    label: 'Help Desk as a Service',
    span: 'lg:col-span-6',
    items: [
      ['Help Desk as a Service', 'L1-L3 ticket handling, user support, access issues, onboarding, and escalation management.'],
      ['Identity & Access', 'Account access, authentication, group membership, role, and license administration.'],
      ['Device Management', 'Endpoint enrollment, compliance profiles, remote lock/wipe support, and software deployment coordination.'],
      ['Tenant Administration', 'Communication, collaboration, permissions, and recurring tenant configuration upkeep.'],
    ],
  },
  {
    id: 'product-support',
    label: 'Product Support as a Service',
    span: 'lg:col-span-3',
    items: [['Product Support as a Service', 'Customer and product support queues, quality review, documentation, and operational reporting.']],
  },
  {
    id: 'operations',
    label: 'Business Processes operations',
    span: 'lg:col-span-3',
    items: [['Operational Reporting', 'Queue health, response targets, recurring blockers, and improvement opportunities.']],
  },
];

const steps = [
  ['Stabilize', 'Document queues, roles, systems, support boundaries, and escalation rules.'],
  ['Operate', 'Run recurring helpdesk, tenant, device, and support tasks against agreed workflows.'],
  ['Improve', 'Report on blockers, repeat issues, automation candidates, and service quality trends.'],
];
---

<Layout socialImage="managed-it" title="Managed IT Services - MSP, Help Desk & Product Support" activePillar="managed-it" description="AGI provides MSP expertise through Help Desk as a Service, Product Support as a Service, managed IT, identity operations, device management, and Business Processes support.">
  <PageHero
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/#services' }, { label: 'Managed IT', href: '/managed-it' }]}
    eyebrow="AGI / Managed IT"
    title="Keep IT support and outsourced operations moving."
    description="AGI provides MSP expertise through Help Desk as a Service, Product Support as a Service, managed IT, and Business Processes operations with clear ownership and escalation."
    accent="global"
    primaryLabel="Scope managed operations"
    primaryHref="/contact?intent=managed-it"
    secondaryLabel="Explore managed services"
    secondaryHref="#services"
    focusLabel="Managed IT focus"
    focusItems={['Help Desk as a Service', 'Product Support as a Service', 'Business Processes operations']}
  />

  <section id="services" class="agi-band agi-section">
    <div class="agi-grid-mask" aria-hidden="true"></div>
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        align="center"
        accent="global"
        eyebrow="Managed Operations"
        title="The recurring work your team needs handled well."
        lede="AGI managed IT services support recurring technology and Business Processes work with clear queue ownership, user support, administration, and escalation discipline."
      />

      <div class="mt-14 grid grid-cols-1 gap-5 lg:grid-cols-12" data-reveal-group>
        {groups.map((group) => (
          <article id={group.id} class:list={['agi-card agi-card--dark agi-card--accent accent-global flex flex-col', group.span]}>
            <span class="agi-eyebrow">{group.label}</span>
            <ul class:list={['mt-5 grid gap-x-6 gap-y-5', group.items.length > 1 && 'sm:grid-cols-2']}>
              {group.items.map(([title, copy]) => (
                <li class="border-t border-white/[0.06] pt-4">
                  <h3 class="font-display text-lg font-bold text-white">{title}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted">{copy}</p>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="agi-section">
    <div class="mx-auto max-w-7xl">
      <SectionHeading align="center" accent="global" eyebrow="Systems We Operate" title="Common workflows AGI can manage." class="mb-14" />
      <ManagedSystems client:visible scope="global" />
    </div>
  </section>

  <section class="agi-band agi-section">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-12 lg:grid-cols-12">
      <SectionHeading
        class="lg:sticky lg:top-28 lg:col-span-4"
        accent="global"
        eyebrow="Operations Visibility"
        title="Support work should be easy to see and measure."
        lede="This illustrative visual represents a customer-facing view of queue health, service coverage, device operations, identity workflows, and Business Processes support performance."
      />
      <div class="lg:col-span-8" data-reveal>
        <ServiceDeskQueue client:visible />
      </div>
    </div>
  </section>

  <section class="agi-section">
    <div class="mx-auto max-w-7xl">
      <SectionHeading accent="global" eyebrow="How delivery runs" title="Stabilize, operate, then improve." />
      <ol class="agi-steps mt-12" style="--steps: 3" data-reveal-group>
        {steps.map(([title, copy]) => (
          <li class="agi-step accent-global">
            <h3 class="font-display text-xl font-bold text-white">{title}</h3>
            <p class="mt-2 max-w-xs text-[0.9375rem] leading-relaxed text-muted">{copy}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ServiceFaqSection service="managed-it" label="Managed IT" accent="global" />

  <BriefPromo />

  <section class="agi-band agi-glow agi-section accent-global">
    <SectionHeading
      align="center"
      accent="global"
      eyebrow="Talk to AGI"
      title="Define the managed service your team needs."
      lede="Discuss Help Desk as a Service, Product Support as a Service, managed IT, or Business Processes operations with AGI managed IT specialists."
    >
      <Button href="/contact?intent=managed-it" accent="global" arrow class="mt-2">Contact AGI</Button>
    </SectionHeading>
  </section>
</Layout>
