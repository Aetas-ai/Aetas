---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ManagedSystems from '../components/ManagedSystems';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { visuals } from '../lib/visuals';

const services = [
  ['Help Desk as a Service', 'L1-L3 ticket handling, user support, access issues, onboarding, and escalation management.'],
  ['Identity & Access', 'Account access, authentication, group membership, role, and license administration.'],
  ['Device Management', 'Endpoint enrollment, compliance profiles, remote lock/wipe support, and software deployment coordination.'],
  ['Tenant Administration', 'Communication, collaboration, permissions, and recurring tenant configuration upkeep.'],
  ['Product Support as a Service', 'Customer and product support queues, quality review, documentation, and operational reporting.'],
  ['Operational Reporting', 'Queue health, response targets, recurring blockers, and improvement opportunities.'],
];

const steps = [
  ['Stabilize', 'Document queues, roles, systems, support boundaries, and escalation rules.'],
  ['Operate', 'Run recurring helpdesk, tenant, device, and support tasks against agreed workflows.'],
  ['Improve', 'Report on blockers, repeat issues, automation candidates, and service quality trends.'],
];
---

<Layout title="Managed IT Services - MSP, Help Desk & Product Support" activePillar="managed-it" description="AGI provides MSP expertise through Help Desk as a Service, Product Support as a Service, managed IT, identity operations, device management, and Business Processes support.">
  <PageHero
    eyebrow="AGI / Managed IT"
    title="Keep IT support and outsourced operations moving."
    description="AGI provides MSP expertise through Help Desk as a Service, Product Support as a Service, managed IT, and Business Processes operations with clear ownership and escalation."
    accent="global"
    image={visuals.globalOps}
    imageAlt="Managed IT and Business Processes operations visualization"
    primaryLabel="Scope managed operations"
    primaryHref="/contact?intent=managed-it"
    secondaryLabel="Explore managed services"
    secondaryHref="#services"
    focusLabel="Managed IT focus"
    focusItems={['Help Desk as a Service', 'Product Support as a Service', 'Business Processes operations']}
  />

  <section id="services" class="section-light agi-section scroll-mt-24">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        align="center"
        accent="global"
        eyebrow="Managed Operations"
        title="The recurring work your team needs handled well."
        lede="AGI managed IT services support recurring technology and Business Processes work with clear queue ownership, user support, administration, and escalation discipline."
      />

      <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8" data-reveal-group>
        {services.map(([title, copy]) => (
          <article class="agi-card agi-card--light agi-card--accent agi-card--interactive accent-global">
            <h3 class="font-display text-xl font-bold text-strong">{title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-dark-raised agi-section">
    <div class="mx-auto max-w-7xl">
      <SectionHeading align="center" accent="global" eyebrow="Systems We Operate" title="Common workflows AGI can manage." class="mb-14" />
      <ManagedSystems client:visible scope="global" />
    </div>
  </section>

  <section class="section-light-muted agi-section">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 lg:grid-cols-12">
      <SectionHeading
        class="lg:col-span-5"
        accent="global"
        eyebrow="Operations Visibility"
        title="Support work should be easy to see and measure."
        lede="This illustrative visual represents a customer-facing view of queue health, service coverage, device operations, identity workflows, and Business Processes support performance."
      />
      <div class="lg:col-span-7" data-reveal-right>
        <div class="media-frame-light">
          <Image src={visuals.globalOps} alt="Managed IT and helpdesk operations visualization" widths={[480, 768, 1080]} sizes="(min-width: 1024px) 46rem, 100vw" class="aspect-video w-full object-cover" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <section class="agi-section">
    <ol class="mx-auto grid max-w-7xl grid-cols-1 gap-6 lg:grid-cols-3 lg:gap-8" data-reveal-group>
      {steps.map(([title, copy], index) => (
        <li class="agi-card agi-card--dark agi-card--accent accent-global">
          <span class="agi-eyebrow">Step {index + 1}</span>
          <h3 class="mt-3 font-display text-2xl font-bold text-white">{title}</h3>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{copy}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section-light agi-section">
    <SectionHeading
      align="center"
      accent="global"
      eyebrow="Talk to AGI"
      title="Define the managed service your team needs."
      lede="Discuss Help Desk as a Service, Product Support as a Service, managed IT, or Business Processes operations with AGI managed IT specialists."
    >
      <Button href="/contact?intent=managed-it" tone="light" arrow class="mt-2">Contact AGI</Button>
    </SectionHeading>
  </section>
</Layout>
