---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';

const roles = [
  { accent: 'security', area: 'Cybersecurity', title: 'Managed Extended Detection and Response Analyst', details: 'Austin, TX (Hybrid) or Manila, PH • Full-time' },
  { accent: 'global', area: 'Managed IT', title: 'IT Systems Administrator', details: 'Manila, Philippines • Full-time (Night Shift)' },
  { accent: 'ai', area: 'AI & Automation', title: 'Machine Learning Engineer (Workflow Automation)', details: 'Austin, TX • Full-time' },
];
---

<Layout socialImage="careers" title="Careers - Join Aetas Global Innovation" description="Explore open roles in cybersecurity, IT managed services, Business Processes operations, and AI systems engineering at Aetas Global Innovation.">
  <PageHero
    eyebrow="Careers at AGI"
    title="Build the systems behind modern service delivery."
    description="Explore roles across cybersecurity, managed IT, Business Processes operations, and Human Led AI."
    compact
    primaryLabel="View open roles"
    primaryHref="#open-roles"
  />

  <section id="open-roles" class="section-light-muted agi-section scroll-mt-24">
    <ul class="mx-auto max-w-4xl space-y-4" data-reveal-group>
      {roles.map((role) => (
        <li class:list={['agi-card agi-card--light agi-card--accent agi-card--interactive flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-center', `accent-${role.accent}`]}>
          <div>
            <span class="agi-eyebrow">{role.area}</span>
            <h3 class="mt-2 font-display text-lg font-bold text-strong">{role.title}</h3>
            <p class="mt-1 text-sm text-muted">{role.details}</p>
          </div>
          <Button href="/contact" tone="light" variant="secondary" stretch class="shrink-0" aria-label={`Apply for ${role.title}`}>Apply Now</Button>
        </li>
      ))}
    </ul>
  </section>
</Layout>
