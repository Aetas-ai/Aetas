---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
---

<Layout title="AGI Brief Ready" description="Download the AGI Operations Readiness Brief from Aetas Global Innovation." noIndex>
  <section class="agi-bob-safe-section px-5 py-20 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-4xl text-center">
      <span class="agi-eyebrow accent-governance">Download Ready</span>
      <h1 class="mt-4 font-display text-display font-bold text-white">
        Your AGI Operations Readiness Brief is ready.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lede text-muted">
        Use this brief to align your team around Human Led AI, security requirements, IT operations, and Business Processes workflows before a deeper scoping conversation.
      </p>

      <div class="agi-card agi-card--dark mt-10 text-left sm:p-8" data-reveal>
        <h2 class="text-2xl font-display font-bold text-white">Brief Summary</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {[
            ['1. Workflow inventory', 'List the repetitive, high-volume, or slow-moving work that could benefit from AI assistance.'],
            ['2. Expert in the Loop', 'Define where Expert Human Oversight of AI is required before customer, system, security, or policy impact.'],
            ['3. Operating signals', 'Connect support queues, identity events, endpoint alerts, and reporting into one service view.'],
            ['4. Implementation path', 'Start with a controlled service engagement, measure results, and expand where impact is clear.'],
          ].map(([title, body]) => (
            <article class="rounded-md border border-white/8 bg-black/25 p-5">
              <h3 class="font-display font-bold text-white">{title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{body}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button href="/contact?intent=ai" arrow stretch class="px-8">Discuss with AGI</Button>
        <Button href="/resources" variant="secondary" stretch class="px-8">Browse resources</Button>
      </div>
    </div>
  </section>
</Layout>
