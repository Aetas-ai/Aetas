---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MxdrConsole from '../components/demos/MxdrConsole';

const mxdrSteps = [
  ['Monitor', 'Monitoring and triaging active security detections.'],
  ['Investigate', 'Investigating suspicious endpoint and identity activity.'],
  ['Respond', 'Following defined response and escalation procedures.'],
  ['Document', 'Documenting investigation and response activity.'],
];

const offensive = [
  ['network-testing', 'Network Security Testing', 'Security testing focused on network exposure, configuration weaknesses, and potential attack paths.'],
  ['application-testing', 'Application Security Testing (Pen Testing)', 'Application security testing focused on identifying and documenting security weaknesses.'],
];
---

<Layout title="Cybersecurity Services - MXDR and Offensive Security" activePillar="security" description="AGI provides MSSP expertise through Managed Extended Detection and Response (MXDR), Network Security Testing, and Application Security Testing (Pen Testing).">
  <PageHero
    eyebrow="AGI / Cybersecurity"
    title="Detect threats. Test defenses. Strengthen resilience."
    description="AGI provides MSSP expertise through Managed Extended Detection and Response (MXDR) and Offensive Security services for monitoring, investigation, response, and security testing."
    accent="security"
    primaryLabel="Scope security services"
    primaryHref="/contact?intent=security"
    secondaryLabel="Explore security services"
    secondaryHref="#services"
    focusLabel="Cybersecurity focus"
    focusItems={['Managed Extended Detection and Response (MXDR)', 'Network Security Testing', 'Application Security Testing (Pen Testing)']}
  />

  <section id="services" class="agi-band agi-section">
    <div class="agi-grid-mask" aria-hidden="true"></div>
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        align="center"
        accent="security"
        eyebrow="Security Services"
        title="Managed detection and offensive testing."
        lede="AGI cybersecurity services are organized into Managed Extended Detection and Response (MXDR) and Offensive Security."
      />

      <div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-12">
        <article id="mxdr" class="agi-card agi-card--dark agi-card--accent accent-security lg:col-span-7" data-reveal>
          <span class="agi-eyebrow">MXDR</span>
          <h3 class="mt-4 font-display text-h3 font-bold text-white">Managed Extended Detection and Response (MXDR)</h3>
          <p class="mt-3 max-w-xl text-[0.9375rem] leading-relaxed text-muted">Continuous detection, investigation, response, and escalation guided by experienced security professionals.</p>
          <ol class="agi-steps mt-10" style="--steps: 4">
            {mxdrSteps.map(([title, body]) => (
              <li class="agi-step">
                <p class="text-sm font-semibold text-white">{title}</p>
                <p class="mt-1 text-[0.8125rem] leading-relaxed text-muted">{body}</p>
              </li>
            ))}
          </ol>
        </article>

        <article id="offensive-security" class="agi-card agi-card--dark accent-security flex flex-col lg:col-span-5" data-reveal>
          <span class="agi-eyebrow">Offensive Security</span>
          <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted">Dedicated testing engagements that evaluate network and application defenses.</p>
          <div class="mt-6 grid flex-1 gap-3">
            {offensive.map(([id, title, body]) => (
              <div id={id} class="rounded-lg border border-white/[0.07] bg-black/20 p-5">
                <h3 class="font-display text-lg font-bold text-white">{title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{body}</p>
              </div>
            ))}
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="agi-section">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-12 lg:grid-cols-12">
      <SectionHeading
        class="lg:sticky lg:top-28 lg:col-span-4"
        accent="security"
        eyebrow="AGI Cybersecurity"
        title="Focused coverage across detection, response, and testing."
        lede="MXDR supports ongoing security monitoring and response, while Offensive Security evaluates network and application defenses through dedicated testing engagements."
      />
      <div class="lg:col-span-8" data-reveal>
        <MxdrConsole client:visible />
      </div>
    </div>
  </section>

  <section class="agi-band agi-glow agi-section accent-security">
    <SectionHeading
      align="center"
      accent="security"
      eyebrow="Talk to AGI"
      title="Scope the security service your environment needs."
      lede="Discuss Managed Extended Detection and Response (MXDR), Network Security Testing, or Application Security Testing (Pen Testing) with AGI cybersecurity specialists."
    >
      <Button href="/contact?intent=security" accent="security" arrow class="mt-2">Contact AGI</Button>
    </SectionHeading>
  </section>
</Layout>
