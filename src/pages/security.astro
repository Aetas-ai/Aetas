---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { visuals } from '../lib/visuals';

const services = [
  ['MXDR', 'Managed Extended Detection and Response (MXDR)', 'Continuous detection, investigation, response, and escalation guided by experienced security professionals.'],
  ['Offensive Security', 'Network Security Testing', 'Security testing focused on network exposure, configuration weaknesses, and potential attack paths.'],
  ['Offensive Security', 'Application Security Testing (Pen Testing)', 'Application security testing focused on identifying and documenting security weaknesses.'],
];
---

<Layout title="Cybersecurity Services - MXDR and Offensive Security" activePillar="security" description="AGI provides MSSP expertise through Managed Extended Detection and Response (MXDR), Network Security Testing, and Application Security Testing (Pen Testing).">
  <PageHero
    eyebrow="AGI / Cybersecurity"
    title="Detect threats. Test defenses. Strengthen resilience."
    description="AGI provides MSSP expertise through Managed Extended Detection and Response (MXDR) and Offensive Security services for monitoring, investigation, response, and security testing."
    accent="security"
    image={visuals.securityOps}
    imageAlt="Cybersecurity monitoring and testing visualization"
    primaryLabel="Scope security services"
    primaryHref="/contact?intent=security"
    secondaryLabel="Explore security services"
    secondaryHref="#services"
    focusLabel="Cybersecurity focus"
    focusItems={['Managed Extended Detection and Response (MXDR)', 'Network Security Testing', 'Application Security Testing (Pen Testing)']}
  />

  <section id="services" class="section-light agi-section scroll-mt-24">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        align="center"
        accent="security"
        eyebrow="Security Services"
        title="Managed detection and offensive testing."
        lede="AGI cybersecurity services are organized into Managed Extended Detection and Response (MXDR) and Offensive Security."
      />

      <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8" data-reveal-group>
        {services.map(([category, title, copy]) => (
          <article class="agi-card agi-card--light agi-card--accent agi-card--interactive accent-security">
            <span class="agi-eyebrow">{category}</span>
            <h3 class="mt-4 font-display text-xl font-bold text-strong">{title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-dark-raised agi-section">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 lg:grid-cols-12">
      <SectionHeading
        class="lg:col-span-5"
        accent="security"
        eyebrow="AGI Cybersecurity"
        title="Focused coverage across detection, response, and testing."
        lede="MXDR supports ongoing security monitoring and response, while Offensive Security evaluates network and application defenses through dedicated testing engagements."
      />

      <div class="lg:col-span-7" data-reveal-right>
        <div class="agi-card agi-card--dark accent-security overflow-hidden p-0">
          <Image src={visuals.securityOps} alt="Managed detection and offensive security visualization" widths={[480, 768, 1080]} sizes="(min-width: 1024px) 46rem, 100vw" class="aspect-video w-full rounded-[inherit] object-cover" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <section class="section-light-muted agi-section">
    <SectionHeading
      align="center"
      accent="security"
      eyebrow="Talk to AGI"
      title="Scope the security service your environment needs."
      lede="Discuss Managed Extended Detection and Response (MXDR), Network Security Testing, or Application Security Testing (Pen Testing) with AGI cybersecurity specialists."
    >
      <Button href="/contact?intent=security" tone="light" arrow class="mt-2">Contact AGI</Button>
    </SectionHeading>
  </section>
</Layout>
