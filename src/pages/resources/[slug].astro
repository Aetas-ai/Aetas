---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { resources } from '../../data/resources';

const resourceAccents = {
  'AI Research': 'ai',
  'Threat Intel': 'security',
  'MSP Operations': 'managed',
} as const;

export function getStaticPaths() {
  return resources.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const accent = resourceAccents[article.category];
---

<Layout socialImage="resources" title={article.title} description={article.summary}>
  <article class="section-dark-raised agi-bob-safe-section px-5 py-16 sm:px-6 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-3xl">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Resources', href: '/resources' }, { label: article.title, href: `/resources/${article.slug}` }]} />

      <header class="mb-12 mt-8 border-b border-white/10 pb-10 sm:mt-10 sm:pb-12">
        <span class:list={['agi-category-label', `agi-category-label--${accent}`]}>{article.category}</span>
        <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-white [overflow-wrap:anywhere] sm:text-5xl">{article.title}</h1>
        <p class="mt-6 text-base leading-7 text-gray-300">{article.summary}</p>
        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs uppercase tracking-widest text-gray-400">
          <span>{article.author}</span>
          <span aria-hidden="true">/</span>
          <span>{article.date}</span>
        </div>
      </header>

      <div class="space-y-7 text-base leading-8 text-gray-300">
        {article.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </article>
</Layout>
