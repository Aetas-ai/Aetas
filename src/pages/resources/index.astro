---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { resources } from '../../data/resources';

const resourceIllustrations = [
  '/undraw-motion-alert.svg',
  '/undraw-data-transfer.svg',
  '/undraw-growth-analytics.svg',
];

const resourceAccents = {
  'AI Research': 'ai',
  'Threat Intel': 'security',
  'MSP Operations': 'managed',
} as const;
---

<Layout title="Intel & Blog — AGI Resources" description="Read perspectives on cyber threat intelligence, IT operations, and AI workflows from Aetas Global Innovation specialists.">
  <PageHero
    eyebrow="Insights and resources"
    title="Practical thinking for modern operations."
    description="Read technical perspectives on cybersecurity, managed IT and support operations, and Human Led AI."
    compact
    primaryLabel="Download the AGI brief"
    primaryHref="/operations-readiness-brief"
  />

  <section class="section-dark-raised agi-bob-safe-section px-5 py-20 sm:px-6 sm:py-24">
    <div class="agi-bob-safe-content mx-auto max-w-7xl">
      <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-2 xl:grid-cols-3">
        {resources.map((article, index) => {
          const accent = resourceAccents[article.category];

          return (
            <article class:list={['agi-resource-card', `agi-resource-card--${accent}`]} data-reveal>
              <div class:list={['agi-resource-thumbnail', `agi-resource-thumbnail--${accent}`]}>
                <img
                  src={resourceIllustrations[index % resourceIllustrations.length]}
                  alt=""
                  class="h-full w-full object-contain"
                  width="240"
                  height="150"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="flex flex-1 flex-col p-6 sm:p-7">
                <span class:list={['agi-category-label self-start', `agi-category-label--${accent}`]}>{article.category}</span>
                <h2 class="mt-5 text-xl font-display font-bold leading-snug text-white">
                  <a class="agi-resource-link" href={`/resources/${article.slug}`}>{article.title}</a>
                </h2>
                <p class="mt-4 flex-1 text-sm leading-relaxed text-gray-300">{article.summary}</p>
                <div class="mt-7 flex flex-wrap items-center justify-between gap-x-5 gap-y-2 border-t border-white/8 pt-4 text-xs text-gray-400">
                  <span>By {article.author}</span>
                  <span>{article.date}</span>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
