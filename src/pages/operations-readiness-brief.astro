---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import FormSubmitButton from '../components/FormSubmitButton.astro';

// Topics come from the approved page description; no page counts or other claims.
const briefTopics = [
  { accent: 'ai', label: 'AI & Automation', title: 'Business Process AI Assimilation' },
  { accent: 'governance', label: 'Oversight', title: 'Expert Human Oversight of AI' },
  { accent: 'security', label: 'Cybersecurity', title: 'MXDR and Offensive Security' },
  { accent: 'global', label: 'Managed IT', title: 'Managed IT and Business Processes operations' },
];
---

<Layout title="Download the AGI Operations Readiness Brief" description="Register to download the Aetas Global Innovation brief on Human Led AI, cybersecurity, managed IT, and Business Processes operations.">
  <PageHero
    eyebrow="AGI operations readiness brief"
    title="A practical starting point for your next operations decision."
    description="Register for a concise guide to evaluating AGI services across Business Process AI Assimilation, MXDR, Offensive Security, managed IT, and Business Processes operations."
    accent="security"
    compact
  />

  <section class="section-light agi-section">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-6">
        <h2 class="font-display text-h2 font-bold text-strong" data-reveal>What the brief helps you evaluate</h2>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2" data-reveal-group>
          {[
            'Identify automation-ready workflows',
            'Evaluate Expert Human Oversight of AI',
            'Map security and IT operations signals',
            'Prepare a practical AGI implementation conversation',
          ].map((item) => (
            <li class="agi-card agi-card--light accent-governance flex items-start gap-3 p-4 text-[0.9375rem] font-semibold text-strong">
              <span class="agi-step-index h-6 w-6 text-xs" aria-hidden="true">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <figure class="brief-preview mt-10" data-reveal>
          <div class="brief-sheet brief-sheet--back" aria-hidden="true"></div>
          <div class="brief-sheet brief-sheet--mid" aria-hidden="true"></div>
          <div class="brief-sheet brief-sheet--front">
            <div class="brief-spectrum" aria-hidden="true"><span></span><span></span><span></span></div>
            <p class="brief-kicker">Aetas Global Innovation</p>
            <p class="brief-title">AGI Operations Readiness Brief</p>
            <p class="brief-subtitle">A practical starting point for your next operations decision.</p>
            <ol class="brief-topics">
              {briefTopics.map((topic, index) => (
                <li class={`accent-${topic.accent}`}>
                  <span class="brief-topic-index">0{index + 1}</span>
                  <span>
                    <span class="brief-topic-label">{topic.label}</span>
                    <span class="brief-topic-title">{topic.title}</span>
                  </span>
                </li>
              ))}
            </ol>
          </div>
          <figcaption class="sr-only">Preview of the topics covered in the AGI Operations Readiness Brief.</figcaption>
        </figure>
      </div>

      <div class="lg:col-span-6">
        <div class="agi-card agi-card--light section-spectrum-card relative overflow-hidden p-6 sm:p-8 lg:p-10" data-reveal>
          <div class="mb-6">
            <h2 class="font-display text-2xl font-bold text-strong">Register to download</h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">
              Share your details and AGI will connect you with the appropriate specialists if your organization wants to discuss implementation.
            </p>
          </div>

          <form class="form-on-light space-y-5" name="agi-readiness-brief" method="post" action="/api/forms/readiness-brief" data-secure-form novalidate>
            <input type="hidden" name="csrf-token" value="" />
            <p class="form-honeypot" aria-hidden="true">
              <label for="brief-website">Leave this field empty</label>
              <input id="brief-website" name="website" type="text" tabindex="-1" autocomplete="off" maxlength="200" />
            </p>
            <p class="form-status" data-form-status role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="brief-first-name" class="agi-field-label">First name</label>
                <input id="brief-first-name" name="first-name" type="text" required autocomplete="given-name" maxlength="80" aria-describedby="brief-first-name-error" class="agi-input" />
                <p id="brief-first-name-error" class="form-field-error" data-field-error="first-name" hidden></p>
              </div>
              <div>
                <label for="brief-last-name" class="agi-field-label">Last name</label>
                <input id="brief-last-name" name="last-name" type="text" required autocomplete="family-name" maxlength="80" aria-describedby="brief-last-name-error" class="agi-input" />
                <p id="brief-last-name-error" class="form-field-error" data-field-error="last-name" hidden></p>
              </div>
            </div>
            <div>
              <label for="brief-email" class="agi-field-label">Work email</label>
              <input id="brief-email" name="email" type="email" required autocomplete="email" inputmode="email" maxlength="254" aria-describedby="brief-email-error" class="agi-input" />
              <p id="brief-email-error" class="form-field-error" data-field-error="email" hidden></p>
            </div>
            <div>
              <label for="brief-company" class="agi-field-label">Company</label>
              <input id="brief-company" name="company" type="text" required autocomplete="organization" maxlength="120" aria-describedby="brief-company-error" class="agi-input" />
              <p id="brief-company-error" class="form-field-error" data-field-error="company" hidden></p>
            </div>
            <div>
              <label for="brief-interest" class="agi-field-label">Primary interest</label>
              <select id="brief-interest" name="interest" required aria-describedby="brief-interest-error" class="agi-input">
                <option value="ai">AI workflow automation</option>
                <option value="security">MXDR / Offensive Security</option>
                <option value="global">Managed IT / Business Processes / Help Desk</option>
                <option value="mixed">Multiple service areas</option>
              </select>
              <p id="brief-interest-error" class="form-field-error" data-field-error="interest" hidden></p>
            </div>
            <FormSubmitButton label="Get the brief" class="agi-btn agi-btn--light-primary w-full" />
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Code-built preview of the brief: a stack of sheets listing its topics. */
  .brief-preview {
    position: relative;
    max-width: 30rem;
    margin-inline: auto;
    padding: 0.75rem 1.25rem 1.5rem;
  }

  .brief-sheet {
    border: 1px solid var(--color-line-light);
    border-radius: 0.75rem;
    background: #ffffff;
    box-shadow: var(--shadow-card-light);
  }

  .brief-sheet--back,
  .brief-sheet--mid {
    position: absolute;
    inset: 0.75rem 1.25rem 1.5rem;
  }

  .brief-sheet--back { transform: rotate(-4deg) translate(-0.5rem, 0.5rem); background: #eef2f6; }
  .brief-sheet--mid { transform: rotate(2.5deg) translate(0.4rem, 0.25rem); background: #f6f8fa; }

  .brief-sheet--front {
    position: relative;
    overflow: hidden;
    padding: 1.75rem 1.75rem 1.5rem;
  }

  .brief-spectrum {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    height: 4px;
  }

  .brief-spectrum span { flex: 1; }
  .brief-spectrum span:nth-child(1) { background: var(--color-ai); }
  .brief-spectrum span:nth-child(2) { background: var(--color-security); }
  .brief-spectrum span:nth-child(3) { background: var(--color-global); }

  .brief-kicker {
    color: var(--color-ink-muted);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .brief-title {
    margin-top: 0.5rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .brief-subtitle {
    margin-top: 0.5rem;
    color: var(--color-ink-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .brief-topics {
    display: grid;
    gap: 0.25rem;
    margin-top: 1.25rem;
    border-top: 1px solid var(--color-line-light);
    padding-top: 0.75rem;
  }

  .brief-topics li {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    border-radius: 0.5rem;
    padding: 0.5rem 0.25rem;
  }

  .brief-topic-index {
    display: inline-grid;
    width: 1.875rem;
    height: 1.875rem;
    flex: none;
    place-items: center;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--accent) 14%, #ffffff);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .brief-topic-label {
    display: block;
    color: var(--accent-ink);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .brief-topic-title {
    display: block;
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.35;
  }
</style>
