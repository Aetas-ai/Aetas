---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Work & Case Studies" description="Approved Aetas Global Innovation case studies will be published here as they become available.">
  <PageHero
    eyebrow="Client work"
    title="Case studies are being prepared for publication."
    description="This page will feature verified, client-approved examples across AGI AI and automation, cybersecurity, and managed IT services. We do not publish unverified results or placeholder performance claims."
    compact
  />

  <section class="section-dark-raised agi-bob-safe-section px-5 py-20 sm:px-6 sm:py-24">
    <div class="agi-bob-safe-content mx-auto max-w-7xl">
      <div class="grid items-stretch gap-5 lg:grid-cols-3" data-reveal-group>
        <article class="agi-practice-panel agi-practice-panel--ai flex min-h-64 flex-col p-6 sm:p-7">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="agi-category-label agi-category-label--ai">AI &amp; Automation</span>
            <span class="agi-status-label">In preparation</span>
          </div>
          <h2 class="mt-8 text-2xl font-display font-bold text-white">Workflow automation</h2>
          <p class="mt-4 text-sm leading-relaxed text-gray-300">Approved case study coming soon.</p>
        </article>
        <article class="agi-practice-panel agi-practice-panel--security flex min-h-64 flex-col p-6 sm:p-7">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="agi-category-label agi-category-label--security">Cybersecurity</span>
            <span class="agi-status-label">In preparation</span>
          </div>
          <h2 class="mt-8 text-2xl font-display font-bold text-white">Cybersecurity services</h2>
          <p class="mt-4 text-sm leading-relaxed text-gray-300">Approved case study coming soon.</p>
        </article>
        <article class="agi-practice-panel agi-practice-panel--managed flex min-h-64 flex-col p-6 sm:p-7">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="agi-category-label agi-category-label--managed">Managed IT</span>
            <span class="agi-status-label">In preparation</span>
          </div>
          <h2 class="mt-8 text-2xl font-display font-bold text-white">Managed IT and support</h2>
          <p class="mt-4 text-sm leading-relaxed text-gray-300">Approved case study coming soon.</p>
        </article>
      </div>

      <div class="mt-10 flex justify-center" data-reveal>
        <a href="/contact" class="agi-dark-button agi-dark-button--primary inline-flex min-h-12 w-full items-center justify-center rounded-lg px-7 py-3 text-center text-sm font-bold sm:w-auto">
          Discuss your requirements
        </a>
      </div>
    </div>
  </section>
</Layout>
