---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Request Received" description="Thank you for contacting Aetas Global Innovation." noIndex>
  <section class="agi-bob-safe-section mx-auto max-w-3xl px-5 py-20 text-center sm:px-6 sm:py-24">
    <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Request Received</span>
    <h1 class="text-4xl sm:text-5xl font-display font-bold text-white mt-3">Thank you for contacting AGI.</h1>
    <p class="text-gray-400 text-sm sm:text-base leading-relaxed mt-5">
      Your request has been received. The next step is a focused conversation about your AI and automation, cybersecurity, managed IT, or technology partnership needs.
    </p>
    <a href="/" class="mt-8 inline-flex min-h-12 items-center justify-center rounded-lg bg-white px-8 py-3 font-bold text-black transition-colors hover:bg-white/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-brand-bg">
      Return home
    </a>
  </section>
</Layout>
