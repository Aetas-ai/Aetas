# Real sending is disabled until Sir Rob approves and notify.aetas.ai is verified.
FORM_DELIVERY_ENABLED=false

# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
FORM_CSRF_SECRET=

# Resend: use a Sending access key restricted to notify.aetas.ai.
RESEND_API_KEY=
FORM_SENDER_EMAIL=forms@notify.aetas.ai
CONTACT_RECIPIENT_EMAIL=info@aetas.ai

# Legacy webhook alternative: clear RESEND_API_KEY and FORM_SENDER_EMAIL first.
# HTTPS endpoint and bearer token remain server-only; no concurrent delivery.
FORM_DELIVERY_URL=
FORM_DELIVERY_BEARER_TOKEN=

# Remove old BREVO_API_KEY and BREVO_SENDER_EMAIL from active environment settings
# before enabling delivery. Existing private credentials can be archived securely.
